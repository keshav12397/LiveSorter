{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build demo",
            "type": "shell",
            "command": "cl.exe",
            "args": [
                "/EHsc",
                "/Zi",
                "/Fe:Demo.exe",
                "Demo.cpp",
                "SDK/CPP/DemoRemoteAPI.cpp",
                "SDK/CPP/TestDualHandle.cpp",
                "SDK/API/SglxCppClient.cpp",
                "/I",
                "SDK/API",
                "/I",
                "SDK/CPP",
                "/link",
                "/LIBPATH:SDK/API",
                "libSglxApi.a"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$msCompile"
            ]
        },
        {
            "type": "cppbuild",
            "label": "C/C++: cl.exe build active file",
            "command": "cl.exe",
            "args": [
                "/Zi",
                "/EHsc",
                "/nologo",
                "/Fe${fileDirname}\\${fileBasenameNoExtension}.exe",
                "${file}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "Task generated by Debugger."
        }
    ]
}